<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Always route app endpoints through front controller,
    # even if physical /admin or /api folders exist.
    RewriteRule ^(admin|api)(/.*)?$ index.php [L,QSA]

    # Block access to sensitive internals and migration assets.
    RewriteRule ^(?:app|config|database)/ - [F,L,NC]
    RewriteRule ^includes/(?:debug|fix_admin_password)\.php$ - [F,L,NC]

    # Serve real static files/folders directly.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes to index.php
    RewriteRule ^ index.php [L,QSA]
</IfModule>

# Basic hardening
Options -Indexes
